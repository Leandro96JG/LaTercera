# Servidor
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# Mercado Pago Argentina
MP_PUBLIC_KEY=tu_public_key_aqui
MP_ACCESS_TOKEN=tu_access_token_aqui
MP_WEBHOOK_SECRET=tu_webhook_secret_aqui

# Autenticación Admin
ADMIN_EMAIL=fotografa@latercera.com.ar
ADMIN_PASSWORD_HASH=tu_hash_aqui
JWT_SECRET=super_secreto_para_tokens

# Almacenamiento (Cloudflare R2 o S3)
STORAGE_BUCKET=latercera-fotos
STORAGE_ENDPOINT=https://tu_account_id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=tu_access_key
STORAGE_SECRET_ACCESS_KEY=tu_secret_key
