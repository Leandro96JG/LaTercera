# Servidor
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000

# Base de Datos Supabase (PostgreSQL Gestionado)
# Obtener en: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_public_key_aqui
# ADVERTENCIA DE SEGURIDAD CRÍTICA:
# SUPABASE_SERVICE_ROLE_KEY cuenta con privilegios totales de administración (BYPASS RLS).
# Solo debe residir en este backend Node.js seguro. NUNCA incluirla en clientes públicos o frontend.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secret_key_aqui

# Mercado Pago Argentina
MP_PUBLIC_KEY=tu_public_key_aqui
MP_ACCESS_TOKEN=tu_access_token_aqui
MP_WEBHOOK_SECRET=tu_webhook_secret_aqui

# Autenticación Admin
ADMIN_EMAIL=fotografa@latercera.com.ar
ADMIN_PASSWORD_HASH=tu_hash_aqui
JWT_SECRET=super_secreto_para_tokens_jwt_min_32_chars_123456

# Token de Descargas Seguras (72 Horas)
DOWNLOAD_TOKEN_SECRET=secreto_descargas_la_tercera_cripto_72_horas_min_32_caracteres_hex

# Almacenamiento (Supabase Storage / S3 / Cloudflare R2)
STORAGE_BUCKET=latercera-fotos
STORAGE_ENDPOINT=https://tu_account_id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=tu_access_key
STORAGE_SECRET_ACCESS_KEY=tu_secret_key
