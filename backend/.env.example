# ==============================================================================
# LA TERCERA FOTOGRAFÍA - CONFIGURACIÓN DEL SERVIDOR BACKEND (.env.example)
# Copia este archivo como .env y completa los valores con tus credenciales reales
# ==============================================================================

# Entorno y Puerto
PORT=4000
NODE_ENV=production

# URLs del Ecosistema
# APP_URL: URL pública del backend (utilizada para webhooks de MP y streaming de fotos)
APP_URL=https://api.latercerafotografia.com.ar
# FRONTEND_URL: Orígenes CORS permitidos (separados por coma para soportar producción, preview y local)
FRONTEND_URL=https://latercerafotografia.com.ar,http://localhost:4200

# Mercado Pago Argentina (Credenciales Oficiales Checkout Pro)
# Obtenidas en: https://www.mercadopago.com.ar/developers/panel/app
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
# Secreto de Webhook para validación HMAC-SHA256 (x-signature anti-tampering)
MP_WEBHOOK_SECRET=tu_secreto_webhook_mercadopago_generado_en_el_panel

# Criptografía y Seguridad Transaccional (Tokens de Descarga y JWT)
# DOWNLOAD_TOKEN_SECRET: Llave HMAC-SHA256 para firmar tokens temporales de descarga (72h)
DOWNLOAD_TOKEN_SECRET=genera_un_secreto_criptografico_aleatorio_minimo_32_caracteres_hex
# JWT_SECRET: Llave de firma para sesiones administrativas de fotógrafos
JWT_SECRET=genera_un_secreto_jwt_super_seguro_y_robusto_para_el_panel_admin_32c

# Supabase (PostgreSQL, Row Level Security & Storage)
# Obtenidas en: https://supabase.com/dashboard/project/<tu-proyecto>/settings/api
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave Pública (anon / public)
SUPABASE_ANON_KEY=tu_supabase_anon_key
# Clave Secreta del Servidor (service_role) - NUNCA compartir ni exponer en el frontend
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_secreta

# Google Drive API (Importación Masiva de Álbumes desde Enlace)
# Obtenida en: https://console.cloud.google.com/apis/credentials
# Restringir en Google Cloud Console para uso exclusivo de "Google Drive API"
GOOGLE_DRIVE_API_KEY=tu_google_drive_api_key_restringida

