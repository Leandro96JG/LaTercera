{
  "mcpServers": {
    "supabase-postgrest": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-postgrest",
        "--apiUrl",
        "https://owybwjeybmzerrspwpjv.supabase.co/rest/v1",
        "--apiKey",
        "${SUPABASE_SERVICE_ROLE_KEY}",
        "--schema",
        "public"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref",
        "owybwjeybmzerrspwpjv"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}
